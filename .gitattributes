# 仓库内统一 LF；Windows 批处理保留 CRLF
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.pdf binary

# 打包的前端第三方库：不计入 GitHub 语言统计，diff 默认折叠
assets/*.min.js linguist-vendored linguist-generated

# 锁文件
Cargo.lock text eol=lf
